# JobPilot server settings. Copy into web/.env.local; never commit real credentials.
# The existing data-root environment name is kept to open installed private data in place.
# CAREER_OPS_ROOT=C:\path\to\jobpilot-data
# CAREER_OPS_WEB_ALLOWED_HOSTS=jobs.example.com

# Business model transport. File-based secrets remain outside the repository.
JOBPILOT_MODEL_TRANSPORT=direct-openai
# JOBPILOT_OPENAI_KEY_FILE=C:\private\openai-key.txt
# OPENAI_API_KEY=
# JOBPILOT_OPENAI_CHAT_URL=https://api.openai.com/v1/chat/completions

# Display/history translation is separate from application-document language.
# JOBPILOT_DEEPSEEK_KEY_FILE=C:\private\deepseek-key.txt
# JOBPILOT_TRANSLATION_MODEL=deepseek-v4-flash
# JOBPILOT_DEEPSEEK_CHAT_URL=https://api.deepseek.com/chat/completions

# Optional local Chromium path for server-side CV PDFs.
# JOBPILOT_CHROMIUM_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe

# Existing optional employer-board discovery; private board configuration is portals.yml.
# JOBPILOT_SEARCH_ENABLE_TRACKED_ATS=1

# The authenticated public gateway uses the existing private mobile-access configuration.
# JOBPILOT_GATEWAY_PORT=3002
# JOBPILOT_UPSTREAM=http://127.0.0.1:3000
# JOBPILOT_ACCESS_CONFIG=C:\private\jobpilot-access.json

# Owner-internal Product Analytics read endpoint used by Project OS backend only.
# Prefer a mounted private file in deployed environments; never ship this secret to browsers/apps.
# JOBPILOT_ANALYTICS_INTERNAL_SECRET_FILE=C:\private\jobpilot-analytics-secret.txt
# JOBPILOT_ANALYTICS_INTERNAL_SECRET=
